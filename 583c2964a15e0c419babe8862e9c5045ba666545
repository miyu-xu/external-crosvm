      "side": 1,
      "message": "We could use `NonZeroU16` rather than `u16` to encode this requirement in the type system rather than making it a runtime check.",
      "revId": "583c2964a15e0c419babe8862e9c5045ba666545",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "c85d525b_f73f845b",
        "filename": "devices/src/virtio/block/asynchronous.rs",
        "patchSetId": 4
      },
      "lineNbr": 585,
