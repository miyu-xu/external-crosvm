      "writtenOn": "2023-01-07T00:17:54Z",
      "side": 1,
      "message": "in pKVM, the swiotlb is going to be in the physical memory, there isn\u0027t a separate memory region in crosvm for it\n\n(https://r.android.com/2275106 is incomplete, sorry if that wasn\u0027t clear)",
      "range": {
        "startLine": 316,
        "startChar": 0,
        "endLine": 318,
        "endChar": 94
      },
      "revId": "897a758931505be142ef35b28a2525290091787d",
