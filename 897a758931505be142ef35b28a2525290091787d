      },
      "lineNbr": 318,
      "author": {
        "id": 1858345
      },
      "writtenOn": "2023-01-10T04:40:06Z",
      "side": 1,
      "message": "Gunyah needs a separate memory region",
      "parentUuid": "794ec73d_8d4a4f6e",
      "range": {
        "startLine": 316,
        "startChar": 0,
        "endLine": 318,
        "endChar": 94
      },
      "revId": "897a758931505be142ef35b28a2525290091787d",
