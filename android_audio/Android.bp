rust_library {
    name: "libandroid_audio",
    crate_name: "android_audio",
    cargo_env_compat: true,
    cargo_pkg_version: "0.1.0",
    compile_multilib: "64",
    srcs: ["src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "libaudio_streams",
    ],
    shared_libs: [
        "libaaudio",
    ],
    proc_macros: ["libasync_trait"],
    apex_available: [
        "com.android.virt",
    ],
}
