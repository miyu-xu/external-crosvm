      "writtenOn": "2023-02-28T21:14:25Z",
      "side": 1,
      "message": "If you look at the new Android.bp and think \"we don\u0027t actually want or need this in Android\", then doing an exclude like this is a good solution. Otherwise you need to figure out how to get the new Android.bp to build.",
      "parentUuid": "5daeb422_1e7d2ed7",
      "range": {
        "startLine": 29,
        "startChar": 0,
        "endLine": 29,
        "endChar": 14
