      "writtenOn": "2022-06-15T23:30:14Z",
      "side": 1,
      "message": "Why aren\u0027t the headers safe? Because they could change and break things? Something else?",
      "parentUuid": "0be5322d_49961c24",
      "range": {
        "startLine": 12,
        "startChar": 14,
        "endLine": 13,
        "endChar": 14
