      "writtenOn": "2023-03-14T15:51:29Z",
      "side": 1,
      "message": "Right now it only provides bit to gunyah backend. This bit would eventually be used to know whether this memory needs to be backed by restricted_memfd, too.",
      "parentUuid": "706a0982_9dccf336",
      "range": {
        "startLine": 305,
