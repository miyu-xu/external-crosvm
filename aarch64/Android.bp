// This file is generated by cargo2android.py --run --device.
// Edited manually.

rust_library_rlib {
    name: "libaarch64",
    defaults: ["crosvm_defaults"],
    crate_name: "aarch64",
    srcs: ["src/lib.rs"],
    rlibs: [
        "libarch",
        "libdata_model",
        "libdevices",
        "libio_jail",
        "libkernel_cmdline",
        "libkvm",
        "libkvm_sys",
        "liblibc",
        "libresources",
        "libsync_rust",
        "libsys_util",
        "libvm_control",
    ],
    proc_macros: [
        "libremain",
    ],
    target: {
        linux_glibc_x86_64: {
            enabled: false,
        },
        android_x86_64: {
            enabled: false,
        },
    },
}
