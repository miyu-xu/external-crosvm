// This file is generated by cargo2android.py --run --device --tests --dependencies --global_defaults=crosvm_defaults --add_workspace.
// Added "composite-disk" feature, dependcies on protos and protobuf.

rust_defaults {
    name: "disk_defaults",
    defaults: ["crosvm_defaults"],
    crate_name: "disk",
    srcs: ["src/disk.rs"],
    test_suites: ["general-tests"],
    auto_gen_config: true,
    edition: "2018",
    rustlibs: [
        "libdata_model",
        "liblibc",
        "libsys_util",
    ],
    proc_macros: [
        "libremain",
    ],
}

rust_test_host {
    name: "disk_host_test_src_disk",
    defaults: ["disk_defaults"],
}

rust_test {
    name: "disk_device_test_src_disk",
    defaults: ["disk_defaults"],
}

rust_library {
    name: "libdisk",
    defaults: ["crosvm_defaults"],
    host_supported: true,
    crate_name: "disk",
    srcs: ["src/disk.rs"],
    edition: "2018",
    features: [
        "composite-disk",
    ],
    rustlibs: [
        "libdata_model",
        "liblibc",
        "libprotobuf",
        "libprotos",
        "libsys_util",
    ],
    proc_macros: [
        "libremain",
    ],
}

