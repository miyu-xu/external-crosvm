        "id": 1944400
      },
      "writtenOn": "2024-04-09T22:37:40Z",
      "side": 1,
      "message": "what\u0027s a `ANativeWindow_lock` and a `ANativeWindow_unlockAndPost`? i don\u0027t see anything like that in your API boundary :)",
      "range": {
        "startLine": 108,
        "startChar": 0,
        "endLine": 109,
        "endChar": 73
      },
      "revId": "9bf13cf253ffbf954ca9369a4b69ef1d50a47152",
