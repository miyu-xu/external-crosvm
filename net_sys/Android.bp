// This file is generated by cargo2android.py.
// Add genrule modules and dependency on those moduels.

rust_library_host_rlib {
    name: "libnet_sys",
    defaults: ["crosvm_defaults"],
    crate_name: "net_sys",
    srcs: ["src/lib.rs"],
    rlibs: [
        "libsys_util",
    ],
    // rustc takes only one source file, in "srcs".
    // Modules in generated_sources are added as implicit dependencies.
    generated_sources: [
        "crosvm_bindgen_if_tun",
        "crosvm_bindgen_iff",
        "crosvm_bindgen_inn",
        "crosvm_bindgen_sockios",
    ],
}

genrule {
    name: "crosvm_bindgen_if_tun",
    defaults: ["crosvm_bindgen_defaults"],
    srcs: ["src/if_tun.h"],
    out: ["if_tun.rs"],
}

genrule {
    name: "crosvm_bindgen_iff",
    defaults: ["crosvm_bindgen_defaults"],
    srcs: ["src/iff.h"],
    out: ["iff.rs"],
    // TODO: share more cmd from defaults
    cmd: "RUSTFMT=prebuilts/rust/linux-x86/1.43.0/bin/rustfmt"
    + " CLANG_PATH=prebuilts/clang/host/linux-x86/clang-r383902/bin/clang"
    + " LIBCLANG_PATH=prebuilts/clang/host/linux-x86/clang-r383902/lib64/libclang.so"
    + " $(location) -o $(out) $(in) --constified-enum '*' --with-derive-default"
    + " -- -D__UAPI_DEF_IF_IFNAMSIZ -D__UAPI_DEF_IF_NET_DEVICE_FLAGS"
    + " -D__UAPI_DEF_IF_IFREQ -D__UAPI_DEF_IF_IFMAP"
    + " && cp $(out) `dirname $(in)`/`basename $(in) .h`.rs",
    // HACK: copy generated file sockios.rs into src for src/lib.rs.
}

genrule {
    name: "crosvm_bindgen_inn",
    defaults: ["crosvm_bindgen_defaults"],
    srcs: ["src/inn.h"],
    out: ["inn.rs"],
}

genrule {
    name: "crosvm_bindgen_sockios",
    defaults: ["crosvm_bindgen_defaults"],
    srcs: ["src/sockios.h"],
    out: ["sockios.rs"],
}
